# AI Runner — .gitignore

# ─── Virtualenv & environnements ─────────────────────
.venv/
venv/
env/
ENV/

# ─── Caches Python ───────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
.coverage.*
htmlcov/

# ─── Packaging / builds ───────────────────────────────
*.egg-info/
dist/
build/
*.egg

# ─── Volumes (données utilisateur) ──────────────────
models/
data/
presets/
config/config.yaml

# ─── Binaires téléchargés ──────────────────────────
llama-bin/

# ─── IDE ─────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo

# ─── Docker ──────────────────────────────────────────
.docker/

# ─── OS ──────────────────────────────────────────────
.DS_Store
Thumbs.db
